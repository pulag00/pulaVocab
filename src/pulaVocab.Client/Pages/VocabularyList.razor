@page "/vocabulary"
@inject IVocabularyApiClient Api
@inject NavigationManager Navigation
<h1>Vocabulario</h1>
<div class="filters"><input placeholder="Buscar palabra o traducción" @bind="filter.Search" @bind:event="oninput" /><select @bind="filter.Language"><option value="">Todos los idiomas</option>@foreach(var x in Enum.GetValues<Language>()){<option value="@x">@x</option>}</select><select @bind="filter.Status"><option value="">Todos los estados</option>@foreach(var x in Enum.GetValues<LearningStatus>()){<option value="@x">@x</option>}</select><button @onclick="Load">Buscar</button></div>
@if (!string.IsNullOrEmpty(error)){<p class="error">@error</p>} @if (loading){<p>Cargando…</p>} else if (data.Items.Count == 0){<p>No hay palabras para mostrar.</p>} else {<div class="cards">@foreach(var item in data.Items){<article class="card @item.Language.ToString().ToLowerInvariant()"><h2>@item.Term</h2><p>@item.MainTranslation</p><small>@item.PartOfSpeech · @item.Level · @item.Status</small><p><a href="/vocabulary/@item.Id">Ver</a> · <a href="/vocabulary/edit/@item.Id">Editar</a> · <button class="link danger" @onclick="() => Delete(item.Id)">Eliminar</button></p></article>}</div><div class="pagination"><button disabled="@(filter.Page <= 1)" @onclick="Previous">Anterior</button><span>Página @filter.Page de @data.TotalPages</span><button disabled="@(filter.Page >= data.TotalPages)" @onclick="Next">Siguiente</button></div>}
@code { VocabularyFilterRequest filter = new(); PagedResponse<VocabularyListItemResponse> data = new(); bool loading = true; string? error; protected override Task OnInitializedAsync()=>Load(); async Task Load(){loading=true;error=null;try{data=await Api.GetPagedAsync(filter);}catch(Exception ex){error=ex.Message;}finally{loading=false;}} async Task Delete(Guid id){if(await JS.InvokeAsync<bool>("confirm", "¿Eliminar esta palabra?")){await Api.DeleteAsync(id);await Load();}} async Task Previous(){filter.Page--;await Load();} async Task Next(){filter.Page++;await Load();} [Inject] IJSRuntime JS {get;set;} = default!; }
