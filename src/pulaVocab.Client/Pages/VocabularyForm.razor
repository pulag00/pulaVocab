@page "/vocabulary/new"
@page "/vocabulary/edit/{Id:guid}"
@inject IVocabularyApiClient Api
@inject NavigationManager Navigation

<h1>@(Id.HasValue ? "Editar palabra" : "Agregar palabra")</h1>

@if (loading)
{
    <p>Cargando…</p>
}
else
{
    <EditForm Model="model" OnValidSubmit="Save">
        <fieldset>
            <legend>Información general</legend>
            <label>Idioma
                <select @bind="model.Language">
                    @foreach (var x in Enum.GetValues<Language>())
                    {
                        <option value="@x">@x</option>
                    }
                </select>
            </label>
            <label>Palabra
                <input @bind="model.Term" @bind:event="oninput" required />
            </label>
            <label>Tipo
                <select @bind="model.PartOfSpeech">
                    <option value="">Sin especificar</option>
                    @foreach (var x in Enum.GetValues<PartOfSpeech>())
                    {
                        <option value="@x">@x</option>
                    }
                </select>
            </label>
            <label>Nivel
                <select @bind="model.Level">
                    <option value="">Sin especificar</option>
                    @foreach (var x in Enum.GetValues<CefrLevel>())
                    {
                        <option value="@x">@x</option>
                    }
                </select>
            </label>
            <label>Estado
                <select @bind="model.Status">
                    @foreach (var x in Enum.GetValues<LearningStatus>())
                    {
                        <option value="@x">@x</option>
                    }
                </select>
            </label>
            <label>Pronunciación
                <input @bind="model.Pronunciation" />
            </label>
            <label>IPA
                <input @bind="model.Ipa" placeholder="/ˈwɜːd/" />
            </label>
            <label>IPA Americano
                <input @bind="model.IpaAmerican" placeholder="/wɝd/" />
            </label>
            <label>IPA Británico
                <input @bind="model.IpaBritish" placeholder="/wɜːd/" />
            </label>
            <label>Sinónimos
                <input @bind="model.Synonyms" placeholder="palabra1, palabra2" />
            </label>
            <label>Antónimos
                <input @bind="model.Antonyms" placeholder="opuesto1, opuesto2" />
            </label>
            <label>Términos relacionados
                <input @bind="model.RelatedTerms" placeholder="relacionado1, relacionado2" />
            </label>
            <div class="actions">
                <button type="button" @onclick="Autocomplete" disabled="@isAutocompleteLoading || string.IsNullOrWhiteSpace(model.Term)">@(isAutocompleteLoading ? "Buscando…" : "Buscar y completar")</button>
                <button type="button" @onclick="ClearAutocomplete" disabled="@isAutocompleteLoading">Limpiar</button>
            </div>
        </fieldset>

        <fieldset>
            <legend>Traducciones</legend>
            @foreach (var meaning in model.Meanings)
            {
                <label>Traducción
                    <input @bind="meaning.Translation" required />
                </label>
                <label>Definición
                    <input @bind="meaning.Definition" />
                </label>
            }
            <button type="button" @onclick="AddMeaning">Agregar traducción</button>
        </fieldset>

        <fieldset>
            <legend>Ejemplos</legend>
            @foreach (var example in model.Examples)
            {
                <label>Ejemplo
                    <input @bind="example.Sentence" />
                </label>
                <label>Traducción
                    <input @bind="example.Translation" />
                </label>
            }
            <button type="button" @onclick="AddExample">Agregar ejemplo</button>
        </fieldset>

        @if (model.Language == Language.English)
        {
            <fieldset class="english">
                <legend>Detalles en inglés</legend>
                <label>Pasado
                    <input @bind="English.PastTense" />
                </label>
                <label>Participio
                    <input @bind="English.PastParticiple" />
                </label>
                <label>Tercera persona
                    <input @bind="English.ThirdPersonSingular" />
                </label>
                <label>Gerundio
                    <input @bind="English.Gerund" />
                </label>
                <label><input type="checkbox" @bind="English.IsIrregularVerb" /> Verbo irregular</label>
                <label>Phrasal verbs
                    <input @bind="English.RelatedPhrasalVerbs" />
                </label>
            </fieldset>
        }
        else
        {
            <fieldset class="german">
                <legend>Detalles en alemán</legend>
                <label>Artículo
                    <input @bind="German.Article" />
                </label>
                <label>Género
                    <select @bind="German.Gender">
                        <option value="">Sin especificar</option>
                        @foreach (var x in Enum.GetValues<GermanGender>())
                        {
                            <option value="@x">@x</option>
                        }
                    </select>
                </label>
                <label>Plural
                    <input @bind="German.Plural" />
                </label>
                <label>Verbo auxiliar
                    <input @bind="German.AuxiliaryVerb" />
                </label>
                <label>Participio
                    <input @bind="German.PastParticiple" />
                </label>
                <label><input type="checkbox" @bind="German.IsSeparableVerb" /> Verbo separable</label>
                <label>Prefijo separable
                    <input @bind="German.SeparablePrefix" />
                </label>
                <label>Caso gramatical
                    <input @bind="German.GoverningCase" />
                </label>
            </fieldset>
        }

        @if (!string.IsNullOrEmpty(error))
        {
            <p class="error">@error</p>
        }

        <button class="button" disabled="@saving">@(saving ? "Guardando…" : "Guardar")</button>
        <a class="button secondary" href="/vocabulary">Cancelar</a>
    </EditForm>
}

@code {
    [Parameter]
    public Guid? Id { get; set; }

    UpdateVocabularyEntryRequest model = new() { Meanings = [new()] };
    EnglishWordDetailsRequest English = new();
    GermanWordDetailsRequest German = new();

    bool loading;
    bool saving;
    bool isAutocompleteLoading;
    string? error;

    protected override async Task OnParametersSetAsync()
    {
        if (Id is not { } id)
        {
            return;
        }

        loading = true;
        var x = await Api.GetByIdAsync(id);
        if (x is null)
        {
            Navigation.NavigateTo("/vocabulary");
            return;
        }

        model = new()
        {
            Term = x.Term,
            Language = x.Language,
            PartOfSpeech = x.PartOfSpeech,
            Level = x.Level,
            Status = x.Status,
            Pronunciation = x.Pronunciation,
            Ipa = x.Ipa,
            IpaAmerican = x.IpaAmerican,
            IpaBritish = x.IpaBritish,
            Synonyms = x.Synonyms,
            Antonyms = x.Antonyms,
            RelatedTerms = x.RelatedTerms,
            PersonalNotes = x.PersonalNotes,
            Source = x.Source,
            Meanings = x.Meanings,
            Examples = x.Examples,
            EnglishDetails = x.EnglishDetails,
            GermanDetails = x.GermanDetails
        };

        English = x.EnglishDetails ?? new();
        German = x.GermanDetails ?? new();
        loading = false;
    }

    async Task Save()
    {
        saving = true;
        error = null;
        model.EnglishDetails = model.Language == Language.English ? English : null;
        model.GermanDetails = model.Language == Language.German ? German : null;

        try
        {
            var result = Id is { } id ? await Api.UpdateAsync(id, model) : await Api.CreateAsync(model);
            Navigation.NavigateTo($"/vocabulary/{result.Id}");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }

    async Task Autocomplete()
    {
        if (string.IsNullOrWhiteSpace(model.Term))
        {
            error = "Ingresa un término para buscar.";
            return;
        }

        error = null;
        isAutocompleteLoading = true;

        try
        {
            var lookupRequest = new VocabularyLookupRequest
            {
                Term = model.Term.Trim(),
                Language = model.Language,
                TranslationLanguage = "Spanish"
            };

            var result = await Api.AutocompleteAsync(lookupRequest);
            if (result is null)
            {
                error = "No se recibió respuesta del servicio de autocompletado.";
                return;
            }

            model.Term = string.IsNullOrWhiteSpace(result.Term) ? model.Term : result.Term;
            model.PartOfSpeech = result.PartOfSpeech ?? model.PartOfSpeech;
            model.Level = result.Level ?? model.Level;
            model.Ipa = result.Ipa;
            model.IpaAmerican = result.IpaAmerican;
            model.IpaBritish = result.IpaBritish;
            model.Synonyms = result.Synonyms?.Any() == true ? string.Join(", ", result.Synonyms) : null;
            model.Antonyms = result.Antonyms?.Any() == true ? string.Join(", ", result.Antonyms) : null;
            model.RelatedTerms = result.RelatedTerms?.Any() == true ? string.Join(", ", result.RelatedTerms) : null;

            var meanings = new List<VocabularyMeaningRequest>();
            if (result.Translations.Any())
            {
                meanings.AddRange(result.Translations.Select(t => new VocabularyMeaningRequest { Translation = t.Text }));
            }

            if (result.Definitions.Any())
            {
                if (meanings.Count == 0)
                {
                    meanings.Add(new VocabularyMeaningRequest { Translation = string.Empty, Definition = result.Definitions[0].Text });
                }
                else
                {
                    meanings[0].Definition = result.Definitions[0].Text;
                    for (var i = 1; i < result.Definitions.Count; i++)
                    {
                        meanings.Add(new VocabularyMeaningRequest { Translation = string.Empty, Definition = result.Definitions[i].Text });
                    }
                }
            }

            if (meanings.Any())
            {
                model.Meanings = meanings;
            }

            if (result.Examples.Any())
            {
                model.Examples = result.Examples.Select(e => new ExampleSentenceRequest { Sentence = e.Sentence, Translation = e.Translation }).ToList();
            }

            if (model.Language == Language.English)
            {
                English.Infinitive = result.Infinitive;
                English.PastTense = result.Past;
                English.PastParticiple = result.PastParticiple;
                English.ThirdPersonSingular = result.ThirdPerson;
                English.Gerund = result.Gerund;
                English.IsIrregularVerb = result.IsIrregular;
                English.RelatedPhrasalVerbs = result.PhrasalVerbs?.Any() == true ? string.Join(", ", result.PhrasalVerbs.Select(x => x.Text)) : English.RelatedPhrasalVerbs;
            }
            else
            {
                German.PastParticiple = result.PastParticiple ?? German.PastParticiple;
                German.IsSeparableVerb = result.IsSeparableVerb;
            }

            if (result.AlreadyExists && result.ExistingEntryId.HasValue)
            {
                error = result.Message ?? "Ya existe una entrada para este término.";
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isAutocompleteLoading = false;
        }
    }

    void ClearAutocomplete()
    {
        model.Ipa = null;
        model.IpaAmerican = null;
        model.IpaBritish = null;
        model.Synonyms = null;
        model.Antonyms = null;
        model.RelatedTerms = null;
        model.Meanings = new List<VocabularyMeaningRequest> { new() };
        model.Examples = new List<ExampleSentenceRequest>();
        if (model.Language == Language.English)
        {
            English = new();
        }
        else
        {
            German = new();
        }
    }

    void AddMeaning() => model.Meanings.Add(new());
    void AddExample() => model.Examples.Add(new());
}
