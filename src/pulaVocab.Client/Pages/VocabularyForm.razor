@page "/vocabulary/new"
@page "/vocabulary/edit/{Id:guid}"
@inject IVocabularyApiClient Api
@inject NavigationManager Navigation
<h1>@(Id.HasValue ? "Editar palabra" : "Agregar palabra")</h1>
@if (loading) { <p>Cargando…</p> } else { <EditForm Model="model" OnValidSubmit="Save"><fieldset><legend>Información general</legend><label>Idioma <select @bind="model.Language">@foreach(var x in Enum.GetValues<Language>()){<option value="@x">@x</option>}</select></label><label>Palabra <input @bind="model.Term" required /></label><label>Tipo <select @bind="model.PartOfSpeech"><option value="">Sin especificar</option>@foreach(var x in Enum.GetValues<PartOfSpeech>()){<option value="@x">@x</option>}</select></label><label>Nivel <select @bind="model.Level"><option value="">Sin especificar</option>@foreach(var x in Enum.GetValues<CefrLevel>()){<option value="@x">@x</option>}</select></label><label>Estado <select @bind="model.Status">@foreach(var x in Enum.GetValues<LearningStatus>()){<option value="@x">@x</option>}</select></label><label>Pronunciación <input @bind="model.Pronunciation" /></label><label>Notas <textarea @bind="model.PersonalNotes"></textarea></label></fieldset><fieldset><legend>Traducciones</legend>@foreach(var meaning in model.Meanings){<label>Traducción <input @bind="meaning.Translation" required /></label><label>Definición <input @bind="meaning.Definition" /></label>}<button type="button" @onclick="AddMeaning">Agregar traducción</button></fieldset><fieldset><legend>Ejemplos</legend>@foreach(var example in model.Examples){<label>Ejemplo <input @bind="example.Sentence" /></label><label>Traducción <input @bind="example.Translation" /></label>}<button type="button" @onclick="AddExample">Agregar ejemplo</button></fieldset>@if(model.Language == Language.English){<fieldset class="english"><legend>Detalles en inglés</legend><label>Pasado <input @bind="English.PastTense" /></label><label>Participio <input @bind="English.PastParticiple" /></label><label>Tercera persona <input @bind="English.ThirdPersonSingular" /></label><label>Gerundio <input @bind="English.Gerund" /></label><label><input type="checkbox" @bind="English.IsIrregularVerb" /> Verbo irregular</label><label>Phrasal verbs <input @bind="English.RelatedPhrasalVerbs" /></label></fieldset>} else {<fieldset class="german"><legend>Detalles en alemán</legend><label>Artículo <input @bind="German.Article" /></label><label>Género <select @bind="German.Gender"><option value="">Sin especificar</option>@foreach(var x in Enum.GetValues<GermanGender>()){<option value="@x">@x</option>}</select></label><label>Plural <input @bind="German.Plural" /></label><label>Verbo auxiliar <input @bind="German.AuxiliaryVerb" /></label><label>Participio <input @bind="German.PastParticiple" /></label><label><input type="checkbox" @bind="German.IsSeparableVerb" /> Verbo separable</label><label>Prefijo separable <input @bind="German.SeparablePrefix" /></label><label>Caso gramatical <input @bind="German.GoverningCase" /></label></fieldset>}@if(!string.IsNullOrEmpty(error)){<p class="error">@error</p>}<button class="button" disabled="@saving">@(saving ? "Guardando…" : "Guardar")</button><a class="button secondary" href="/vocabulary">Cancelar</a></EditForm> }
@code { [Parameter] public Guid? Id {get;set;} UpdateVocabularyEntryRequest model = new(){ Meanings = [new()] }; EnglishWordDetailsRequest English = new(); GermanWordDetailsRequest German = new(); bool loading, saving; string? error; protected override async Task OnParametersSetAsync(){if(Id is not { } id)return;loading=true;var x=await Api.GetByIdAsync(id);if(x is null){Navigation.NavigateTo("/vocabulary");return;}model=new(){Term=x.Term,Language=x.Language,PartOfSpeech=x.PartOfSpeech,Level=x.Level,Status=x.Status,Pronunciation=x.Pronunciation,PersonalNotes=x.PersonalNotes,Source=x.Source,Meanings=x.Meanings,Examples=x.Examples};English=x.EnglishDetails??new();German=x.GermanDetails??new();loading=false;} async Task Save(){saving=true;error=null;model.EnglishDetails=model.Language==Language.English?English:null;model.GermanDetails=model.Language==Language.German?German:null;try{var result=Id is { } id?await Api.UpdateAsync(id,model):await Api.CreateAsync(model);Navigation.NavigateTo($"/vocabulary/{result.Id}");}catch(Exception ex){error=ex.Message;}finally{saving=false;}} void AddMeaning()=>model.Meanings.Add(new()); void AddExample()=>model.Examples.Add(new()); }
