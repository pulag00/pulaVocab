@page "/practicar"
@inject IPracticeApiClient Api
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Practicar vocabulario</PageTitle>
<h1>Practicar vocabulario</h1>
@if (language is null)
{
 <h2>¿Qué idioma quieres practicar?</h2><div class="practice-grid"><button class="choice" @onclick="()=>Choose(Language.English)"><span>🇬🇧</span><strong>Inglés</strong></button><button class="choice" @onclick="()=>Choose(Language.German)"><span>🇩🇪</span><strong>Alemán</strong></button></div>
}
else if (loading) { <p role="status">Cargando datos reales…</p> }
else if (error is not null) { <div class="alert error" role="alert">@error <button @onclick="Load">Reintentar</button></div> }
else if (summary is not null) { <section class="practice-card"><h2>Sesión terminada</h2><p><strong>Idioma:</strong> @LanguageName(summary.Language)</p><p><strong>Ejercicio:</strong> @ModeName(summary.ExerciseType)</p><div class="stats"><article><strong>@summary.PracticedCount</strong><span>Practicadas</span></article><article><strong>@summary.CorrectCount</strong><span>Aciertos</span></article><article><strong>@summary.IncorrectCount</strong><span>Errores</span></article><article><strong>@Percent(summary)</strong><span>Resultado</span></article></div><div class="actions">@if(summary.IncorrectWordIds.Count>0){<button @onclick="RepeatWrong">Practicar nuevamente las incorrectas</button>}<button @onclick="Reset">Volver a practicar</button><a class="button secondary" href="/vocabulary">Ir a mis palabras</a><button class="secondary" @onclick="ChangeLanguage">Cambiar idioma</button></div></section> }
else if (session is null) { <section><div class="heading-row"><h2>@LanguageName(language.Value)</h2><button class="secondary" @onclick="ChangeLanguage">Cambiar idioma</button></div><div class="stats"><article><strong>@stats.Total</strong><span>Total</span></article><article><strong>@stats.New</strong><span>Nuevas</span></article><article><strong>@stats.DueToday</strong><span>Pendientes hoy</span></article><article><strong>@stats.Difficult</strong><span>Difíciles</span></article><article><strong>@stats.Mastered</strong><span>Dominadas</span></article><article><strong>@(stats.RecentAccuracy)%</strong><span>Acierto reciente</span></article></div>
 <h3>Filtros</h3><div class="filters"><label>Cantidad<select @bind="filter.Count"><option>5</option><option>10</option><option>15</option><option>20</option></select></label><label>Nivel<select @bind="levelText"><option value="">Todos</option>@foreach(var x in stats.Levels){<option>@x</option>}</select></label><label>Categoría<select @bind="posText"><option value="">Todas</option>@foreach(var x in stats.PartsOfSpeech){<option>@x</option>}</select></label><label>Estado<select @bind="filter.State"><option value="all">Todas las palabras</option><option value="favorites">Favoritas</option><option value="new">Nuevas</option><option value="difficult">Difíciles</option><option value="due">Pendientes para hoy</option><option value="mastered">Dominadas</option></select></label></div>
 <h3>Modo</h3><div class="practice-grid"><button class="@ChoiceClass(PracticeExerciseType.Flashcards)" @onclick="()=>SelectMode(PracticeExerciseType.Flashcards)">🗂️<strong>Tarjetas de vocabulario</strong></button><button class="@ChoiceClass(PracticeExerciseType.Matching)" @onclick="()=>SelectMode(PracticeExerciseType.Matching)">🧩<strong>Emparejar palabras</strong></button></div>@if(preview.Count==0){<p>No hay palabras que cumplan estos filtros.</p>} @if(mode==PracticeExerciseType.Matching && preview.Count is >0 and <4){<div class="alert"><strong>No hay suficientes palabras para crear una ronda de emparejamiento con estos filtros.</strong><div class="actions"><button @onclick="ExpandFilters">Ampliar filtros</button><button @onclick="()=>SelectMode(PracticeExerciseType.Flashcards)">Practicar con tarjetas</button><button @onclick="UseAll">Usar todas las palabras de este idioma</button><button @onclick="ChangeLanguage">Cambiar idioma</button></div></div>}<button disabled="@(mode is null||preview.Count==0||(mode==PracticeExerciseType.Matching&&preview.Count<4))" @onclick="Start">Comenzar práctica</button></section> }
else if (session.ExerciseType==PracticeExerciseType.Flashcards) { var word=session.Words[index]; <section class="practice-card"><div class="heading-row"><span>@(index+1) de @session.Words.Count</span><button class="danger-button" @onclick="EndEarly">Finalizar sesión</button></div><progress max="@session.Words.Count" value="@(index+1)"></progress><p>@LanguageName(word.Language)</p><h2 class="practice-term">@word.Term</h2>@if(!string.IsNullOrWhiteSpace(word.Pronunciation??word.Ipa)){<p>@(word.Pronunciation??word.Ipa)</p>}@if(!revealed){<button @onclick="Reveal">Mostrar respuesta</button>}else{<div class="answer"><h3>@word.MainTranslation</h3>@foreach(var m in word.Meanings){if(m.Translation!=word.MainTranslation){<p>@m.Translation</p>}if(!string.IsNullOrWhiteSpace(m.Definition)){<p><b>Definición:</b> @m.Definition</p>}if(!string.IsNullOrWhiteSpace(m.Context)){<p><b>Contexto:</b> @m.Context</p>}}@if(word.PartOfSpeech is not null){<p><b>Categoría:</b> @word.PartOfSpeech</p>}@foreach(var e in word.Examples){<p><b>Ejemplo:</b> @e.Sentence<br><span>@e.Translation</span></p>}@if(!string.IsNullOrWhiteSpace(word.Synonyms)){<p><b>Sinónimos:</b> @word.Synonyms</p>}@if(word.EnglishDetails is not null){<p>@VerbForms(word.EnglishDetails)</p>}@if(word.GermanDetails is not null){<p>@GermanInfo(word.GermanDetails)</p>}</div><div class="rating"><button disabled="@saving" @onclick="()=>Rate(PracticeRating.Forgot)">No la recordé</button><button disabled="@saving" @onclick="()=>Rate(PracticeRating.Hard)">Difícil</button><button disabled="@saving" @onclick="()=>Rate(PracticeRating.Good)">Bien</button><button disabled="@saving" @onclick="()=>Rate(PracticeRating.Easy)">Fácil</button></div>}@if(saving){<p>Guardando…</p>}</section> }
else { <section><div class="heading-row"><h2>Empareja las palabras</h2><button class="danger-button" @onclick="EndEarly">Finalizar sesión</button></div><p>@(roundStart+1)-@Math.Min(roundStart+roundWords.Count,session.Words.Count) de @session.Words.Count</p><div class="match-grid"><div><h3>Palabras</h3>@foreach(var w in roundWords){<button class="@MatchClass(w.Id)" disabled="@checkedRound" @onclick="()=>selectedWord=w.Id">@w.Term @if(AssignedMeaning(w.Id) is { } assigned){<small>→ @assigned</small>}</button>}</div><div><h3>Significados</h3>@foreach(var m in roundMeanings){<button class="match" disabled="@(checkedRound||selectedWord is null)" @onclick="()=>Assign(m.Id)">@m.MainTranslation</button>}</div></div>@if(checkedRound){@foreach(var w in roundWords.Where(w=>!IsCorrect(w.Id))){<p class="error">@w.Term: elegiste @SelectedMeaning(w.Id); correcta: @w.MainTranslation</p>}}<div class="actions"><button disabled="@(checkedRound||assignments.Count!=roundWords.Count||saving)" @onclick="Check">Comprobar respuestas</button><button disabled="@(checkedRound||assignments.Count==0)" @onclick="Clear">Limpiar selecciones</button>@if(checkedRound){<button @onclick="Continue">Continuar</button>}</div></section> }

@code {
 Language? language; PracticeStatisticsResponse stats=new(); PracticeFilterRequest filter=new(); PracticeExerciseType? mode; IReadOnlyList<PracticeWordResponse> preview=[]; PracticeSessionResponse? session,summary; bool loading,saving,revealed,checkedRound; string? error,levelText,posText; int index,roundStart; Guid? selectedWord; List<PracticeWordResponse> roundWords=[],roundMeanings=[]; Dictionary<Guid,Guid> assignments=[]; CancellationTokenSource cts=new();
 async Task Choose(Language l){language=l;filter=new(){Language=l,Count=10};mode=null;await Load();} async Task Load(){loading=true;error=null;try{stats=await Api.Statistics(language!.Value,cts.Token);await Refresh();}catch(Exception){error="No pudimos cargar la práctica. Comprueba tu conexión e inténtalo otra vez.";}finally{loading=false;}}
 async Task Refresh(){filter.Level=Enum.TryParse<CefrLevel>(levelText,out var l)?l:null;filter.PartOfSpeech=Enum.TryParse<PartOfSpeech>(posText,out var p)?p:null;preview=await Api.Preview(filter,cts.Token);if(mode==PracticeExerciseType.Matching)preview=MatchingRoundBuilder.RemoveAmbiguous(preview);} async Task SelectMode(PracticeExerciseType m){mode=m;await Refresh();} async Task Start(){saving=true;try{await Refresh();session=await Api.Start(new(){Filter=filter,ExerciseType=mode!.Value},cts.Token);index=0;revealed=false;if(mode==PracticeExerciseType.Matching)BuildRound();}catch(Exception){error="No se pudo iniciar la práctica.";}finally{saving=false;}}
 void Reveal()=>revealed=true; async Task Rate(PracticeRating r){if(!revealed||saving)return;saving=true;try{await Api.Answer(session!.Id,new(){VocabularyEntryId=session.Words[index].Id,Rating=r,Answer=r.ToString(),IsCorrect=r!=PracticeRating.Forgot},cts.Token);if(++index>=session.Words.Count)summary=await Api.Finish(session.Id,false,cts.Token);else revealed=false;}catch(Exception){error="No se pudo guardar. Tu tarjeta sigue aquí; vuelve a intentarlo.";}finally{saving=false;}}
 void BuildRound(){assignments.Clear();checkedRound=false;selectedWord=null;roundWords=session!.Words.Skip(roundStart).Take(6).ToList();roundMeanings=roundWords.ToList();MatchingRoundBuilder.Shuffle(roundMeanings,Random.Shared);if(roundMeanings.Count>1&&roundMeanings.SequenceEqual(roundWords))MatchingRoundBuilder.Shuffle(roundMeanings,Random.Shared);} void Assign(Guid meaning){if(selectedWord is null)return;foreach(var key in assignments.Where(x=>x.Value==meaning).Select(x=>x.Key).ToList())assignments.Remove(key);assignments[selectedWord.Value]=meaning;selectedWord=null;} void Clear()=>assignments.Clear(); string ChoiceClass(PracticeExerciseType value)=>mode==value?"choice selected":"choice"; string MatchClass(Guid id)=>$"match{(selectedWord==id?" selected":"")}{(checkedRound?(IsCorrect(id)?" correct":" incorrect"):"")}"; string? AssignedMeaning(Guid id)=>assignments.TryGetValue(id,out var value)?roundMeanings.FirstOrDefault(x=>x.Id==value)?.MainTranslation:null; bool IsCorrect(Guid id)=>assignments.TryGetValue(id,out var v)&&v==id;string SelectedMeaning(Guid id)=>assignments.TryGetValue(id,out var v)?roundMeanings.Single(x=>x.Id==v).MainTranslation:"sin respuesta";
 async Task Check(){saving=true;try{foreach(var w in roundWords)await Api.Answer(session!.Id,new(){VocabularyEntryId=w.Id,Answer=SelectedMeaning(w.Id),IsCorrect=IsCorrect(w.Id),AttemptNumber=1},cts.Token);checkedRound=true;}catch(Exception){error="No se pudieron guardar las respuestas. Puedes reintentar.";}finally{saving=false;}} async Task Continue(){roundStart+=roundWords.Count;if(roundStart>=session!.Words.Count)summary=await Api.Finish(session.Id,false,cts.Token);else BuildRound();}
 async Task EndEarly(){if(await JS.InvokeAsync<bool>("confirm","¿Finalizar la sesión? Se conservarán tus respuestas."))summary=await Api.Finish(session!.Id,true,cts.Token);} void ChangeLanguage(){language=null;Reset();} void Reset(){session=null;summary=null;mode=null;index=roundStart=0;preview=[];error=null;if(language is not null)_=Load();} async Task RepeatWrong(){filter.WordIds=summary!.IncorrectWordIds;filter.Count=summary.IncorrectWordIds.Count;mode=summary.ExerciseType;summary=null;await Start();} async Task ExpandFilters(){filter.Level=null;filter.PartOfSpeech=null;levelText=posText="";filter.State="all";await Refresh();} async Task UseAll(){await ExpandFilters();filter.Count=20;await Refresh();} static string LanguageName(Language l)=>l==Language.English?"Inglés":"Alemán";static string ModeName(PracticeExerciseType m)=>m==PracticeExerciseType.Flashcards?"Tarjetas":"Emparejamiento";static string Percent(PracticeSessionResponse s)=>s.PracticedCount==0?"0%":$"{Math.Round(s.CorrectCount*100d/s.PracticedCount)}%";static string VerbForms(PracticeEnglishDetails e)=>string.Join(" · ",new[]{e.Infinitive,e.PastTense,e.PastParticiple,e.ThirdPersonSingular,e.Gerund,e.RelatedPhrasalVerbs}.Where(x=>!string.IsNullOrWhiteSpace(x)));static string GermanInfo(PracticeGermanDetails g)=>string.Join(" · ",new[]{g.Article,g.Gender,g.Plural,g.AuxiliaryVerb,g.PastParticiple,g.IsSeparableVerb?$"Separable: {g.SeparablePrefix}":null}.Where(x=>!string.IsNullOrWhiteSpace(x))); public void Dispose()=>cts.Cancel();
}
